// Used ONLY by CI / the Payload CLI to run migrations (and the build) against the
// PREVIEW D1 + R2 resources. It is never deployed as a Worker.
// The values below MUST match the "previews" block in wrangler.jsonc.
// see https://developers.cloudflare.com/workers/previews/resources/#d1-migrations
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "short-url",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "database_name": "replace-me-preview-d1",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "replace-me-preview-r2",
    },
  ],
}
