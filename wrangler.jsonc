{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "short-url",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // ───────────────────────── PRODUCTION (main branch) ─────────────────────────
  // Production is served on the custom domain url.devslix.com
  "routes": [
    {
      "pattern": "url.devslix.com",
      "custom_domain": true,
    },
  ],
  // Required for branch Preview URLs: <branch>-short-url.<subdomain>.workers.dev
  "preview_urls": true,

  // NOTE: NEXT_PUBLIC_SERVER_URL is inlined by Next.js at BUILD time, so it is set by the
  // GitHub Actions workflow (production = https://url.devslix.com, previews = their Preview URL).
  "d1_databases": [
    {
      "binding": "D1",
      // TODO: replace with the PRODUCTION D1 database name + id
      "database_id": "00000000-0000-0000-0000-000000000001",
      "database_name": "replace-me-prod-d1",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // TODO: replace with the PRODUCTION R2 bucket name
      "bucket_name": "replace-me-prod-r2",
    },
  ],
  "observability": {
    "enabled": true,
  },

  // ───────────────────── PREVIEWS (every non-main branch) ─────────────────────
  // Previews do not inherit production bindings. They use their own D1 + R2.
  // see https://developers.cloudflare.com/workers/previews/configuration/
  // Keep these values in sync with wrangler.preview-migrations.jsonc
  "previews": {
    "d1_databases": [
      {
        "binding": "D1",
        // TODO: replace with the PREVIEW D1 database name + id
        "database_id": "00000000-0000-0000-0000-000000000002",
        "database_name": "replace-me-preview-d1",
        "remote": true,
      },
    ],
    "r2_buckets": [
      {
        "binding": "R2",
        // TODO: replace with the PREVIEW R2 bucket name
        "bucket_name": "replace-me-preview-r2",
      },
    ],
    "observability": {
      "enabled": true,
    },
  },
}
